# Build output (all executables go here)
build/

# Compiler leftovers, if any land outside build/
*.o
*.d
*.dSYM/

# Generated test data (gen recreates it)
tests/data/*.bin

# Coverage files (Stage 6)  
*.gcda
*.gcno
*.profraw
coverage/

# STM32 firmware (CubeMX + CMake projects)
# build/ above already covers each project's build/Debug and build/Release
firmware/**/Debug/
firmware/**/Release/
# HAL + CMSIS libraries: CubeMX regenerates them from the .ioc
firmware/**/Drivers/
# CubeMX's own cache file, regenerated on every Generate Code
firmware/**/.mxproject
# Build outputs, in case any land outside build/
firmware/**/*.elf
firmware/**/*.bin
firmware/**/*.hex
firmware/**/*.map
firmware/**/*.list
firmware/**/*.su

# macOS and editors
.DS_Store
.vscode/
.idea/

#executables
main
gen
/lab
